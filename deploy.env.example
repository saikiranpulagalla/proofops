# ProofOps V1.0 release-candidate environment.
# Never commit real values. Use a dedicated synthetic Google test account/data set.

# Runtime: demo uses fake providers; live refuses any fake-provider fallback.
PROOFOPS_RUNTIME=live

# Browser/API security. Generate a high-entropy secret and strong one-time demo password.
PROOFOPS_SESSION_SECRET=replace-with-at-least-32-random-bytes
PROOFOPS_UI_PASSWORD=replace-with-a-strong-password
PROOFOPS_ACTOR=judge
PROOFOPS_ALLOWED_ORIGIN=https://your-proofops-demo.example
PROOFOPS_SECURE_COOKIE=1
PROOFOPS_SESSION_TTL_SECONDS=3600
PROOFOPS_MAX_REQUEST_BYTES=65536
PROOFOPS_LOGIN_MAX_FAILURES=5
PROOFOPS_LOGIN_WINDOW_SECONDS=300
PROOFOPS_LOGIN_LOCKOUT_SECONDS=300
PROOFOPS_SESSION_SECRET_VERSION=replace-with-secret-manager-version
PROOFOPS_UI_PASSWORD_VERSION=replace-with-secret-manager-version

# Target deployment database. V1.0 live runtime refuses SQLite.
PROOFOPS_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# Qualified live runtime is synthetic-only and requires explicit effect enablement.
PROOFOPS_ALLOW_LIVE_PROVIDER_EFFECTS=YES
PROOFOPS_SYNTHETIC_DATASET=YES

# Dedicated Google OAuth test user.
PROOFOPS_GOOGLE_TOKEN_FILE=/run/secrets/proofops-google-token.json
PROOFOPS_SHEETS_SPREADSHEET_ID=replace-with-synthetic-sheet-id
PROOFOPS_SHEETS_SHEET_NAME=Customers
PROOFOPS_GMAIL_SENDER=proofops-test@example.com

# Exact trusted identity bindings. These are configuration, not model output.
PROOFOPS_CONTACTS_JSON={"SMOKE-C001":"proofops-test@example.com"}
PROOFOPS_ALLOWED_TEST_RECIPIENTS=proofops-test@example.com
PROOFOPS_RENEWAL_THREADS_JSON={"SMOKE-R1":[]}

# Gemini planner. The model receives no tools.
GEMINI_API_KEY=replace-with-secret
PROOFOPS_GEMINI_MODEL=gemini-3.8-flash

# Conservative ambiguous-send reconciliation.
PROOFOPS_RECONCILIATION_GRACE_SECONDS=10
PROOFOPS_MIN_ABSENCE_CHECKS=2
PROOFOPS_APPROVAL_CONTINUATION_TTL_SECONDS=900

# Final RC6 promotion qualification. All contacts remain the authenticated Gmail test mailbox.
# PROOFOPS_QUALIFICATION_MODE=YES
# PROOFOPS_E2E_CUSTOMER_ID=SMOKE-C001
# PROOFOPS_E2E_ACCEPTED_CUSTOMER_ID=SMOKE-C002
# PROOFOPS_QUALIFICATION_RENEWAL_ID=SMOKE-R1
# PROOFOPS_GEMINI_QUALIFICATION_TRIALS=2
# PROOFOPS_DEPLOYMENT_ARTIFACT_DIGEST=<sha256 of exact deployed image/artifact>
# PROOFOPS_DEPLOY_RESTART_COMMAND=<external restart command; no shell expansion>
# PROOFOPS_DEPLOY_RESTART_COMMAND_ID=<non-secret stable identifier for restart mechanism>
# PROOFOPS_QUALIFICATION_FAULT_MODE=gmail_commit_then_lose_first_response
# PROOFOPS_DEPLOYED_BASE_URL=https://your-proofops-demo.example
# PROOFOPS_RELEASE_SIGNING_KEY_FILE=/run/secrets/proofops-v1-release-ed25519.pem
# PROOFOPS_RELEASE_PUBLIC_KEY_SHA256=<pinned Ed25519 public-key fingerprint>
